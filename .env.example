# Runtime identity. Hosted deployments use "production" or "preview".
SLIPWELL_ENVIRONMENT=local

# Public, non-secret canonical URL used for links and auth callback construction.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project values from the Connect dialog. These are intentionally blank
# until a local or production project has been provisioned. The publishable key
# is safe for the browser; never use a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production-only, provider-neutral telemetry ingestion. The operations sink
# receives scrubbed logs, traces, metrics, errors, and alerts. The analytics
# sink receives only allowlisted product events and properties. Tokens must
# never be configured for local development or credential-free previews.
OBSERVABILITY_INGEST_URL=
OBSERVABILITY_INGEST_TOKEN=
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_TOKEN=

# Content-free operational alert thresholds.
ALERT_QUEUE_AGE_SECONDS=300
ALERT_PROCESSING_FAILURES_PER_HOUR=5
ALERT_AUTHORIZATION_FAILURES_PER_5M=3
